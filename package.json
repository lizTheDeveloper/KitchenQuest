{
  "name": "kitchenquest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kitchen Quest — a cooking RPG built with Phaser and TypeScript",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @kitchenquest/game",
    "build": "npm run build -w @kitchenquest/game",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint:install": "npm ci --prefix tools/lint",
    "lint": "npm run lint:eslint && npm run lint:arch && npm run lint:dead",
    "lint:eslint": "node --max-old-space-size=6144 tools/lint/node_modules/.bin/eslint .",
    "lint:arch": "tools/lint/node_modules/.bin/depcruise --config .dependency-cruiser.cjs apps packages",
    "lint:dead": "tools/lint/node_modules/.bin/knip",
    "format:check": "tools/lint/node_modules/.bin/prettier --check .",
    "test:e2e": "npm run test:e2e -w @kitchenquest/game"
  },
  "overrides": {
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
