{
  "name": "kitchenquest",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kitchen Quest — a cooking RPG built with Phaser and TypeScript",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @kitchenquest/game",
    "build": "npm run build -w @kitchenquest/game",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
