# API (apps/api). Copy to .env and export, or set in your shell.
# scripts/dev-db.sh start prints the two database URLs.
DATABASE_URL=postgres://postgres@localhost:54329/kitchenquest
TEST_DATABASE_URL=postgres://postgres@localhost:54329/kitchenquest_test
# Key ring (C-2): comma-separated id:base64 pairs, each 32 random bytes
# (openssl rand -base64 32). DATA_KEY_ID names the active one. Keep retired
# keys in the ring until `npm run rekey -w @kitchenquest/api` reports 0 remaining.
# Never commit real keys; see docs/compliance/key-management.md.
DATA_KEYS=
DATA_KEY_ID=k1
APP_ORIGIN=http://localhost:5173
MAILER=log
# SMTP_URL=smtp://user:pass@host:587
PORT=3000
