# API (apps/api). Copy to .env and export, or set in your shell.
# scripts/dev-db.sh start prints the two database URLs.
DATABASE_URL=postgres://postgres@localhost:54329/kitchenquest
TEST_DATABASE_URL=postgres://postgres@localhost:54329/kitchenquest_test
# Key ring (C-2): comma-separated id:base64 pairs, each 32 random bytes
# (openssl rand -base64 32). DATA_KEY_ID names the active one. Keep retired
# keys in the ring until `npm run rekey -w @kitchenquest/api` reports 0 remaining.
# Never commit real keys; see docs/compliance/key-management.md.
DATA_KEYS=
DATA_KEY_ID=k1
# HMAC key for audit-log pseudonyms of deleted users (32 bytes, base64).
# Separate from DATA_KEYS and never rotated; escrow it like a ring key.
PSEUDONYM_KEY=
APP_ORIGIN=http://localhost:5173
MAILER=log
# SMTP_URL=smtp://user:pass@host:587
PORT=3000
# Production deploys MUST set NODE_ENV=production: the AI's DPA gate (P-11) keys on it.
# NODE_ENV=production
# Deploy MUST set this to the reverse proxy (hop count or its addresses): the search, export and mentor limiters key on the client IP.
TRUST_PROXY=false
# AI (the Pan). Off by default; with it off no other AI variable is read.
# In production the API refuses to boot with AI_ENABLED=true until
# docs/compliance/processors.json lists the OpenRouter DPAs as signed (P-11).
# The data policy (no retention, no training, the allow-list) is pinned in code (C-14).
AI_ENABLED=false
# Never a :free variant (C-14).
AI_MODEL=qwen/qwen3.8-27b
# OpenRouter provider allow-list, in order. Re-check monthly from
# /models/qwen/qwen3.8-27b/endpoints; exclude fp4 providers (spike §6.6).
# ModelRun left the list on 2026-11-11 (docs/compliance/vendors/openrouter.md).
AI_PROVIDERS=tenstorrent
# Required when AI_ENABLED=true:
# OPENROUTER_API_KEY=
# AI_DAILY_BUDGET_USD=
# AI_TIMEOUT_MS=10000
# Voice service (apps/voice). A private WebSocket service: only the API connects, with the shared token.
# It keeps no audio and logs only numbers and enums (C-18). Every model must be `allowed` in data/voice-models.json.
VOICE_PORT=3100
# Shared with the API; at least 32 bytes in production (openssl rand -base64 32). Never commit a real one.
VOICE_SERVICE_TOKEN=
# fake (dev and CI: no models) or worker (M7 Step 3). Production refuses fake.
VOICE_ENGINE=fake
VOICE_STT_MODEL=faster-whisper-base.en
VOICE_TTS_MODEL=piper-en_GB-northern_english_male-medium
VOICE_PAN_VOICE=northern_english_male
VOICE_MAX_CONNECTIONS=50
