{
  "name": "@kitchenquest/game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kitchen Quest — a web game built with Phaser and TypeScript",
  "scripts": {
    "dev": "vite --configLoader runner",
    "build": "tsc --noEmit && vite build --configLoader runner",
    "preview": "vite preview --configLoader runner",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.sw.json",
    "test": "NODE_OPTIONS=--no-warnings=ExperimentalWarning vitest run --configLoader runner",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@kitchenquest/core": "*",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@types/node": "^22.20.5",
    "happy-dom": "^21.0.4",
    "playwright": "1.65.0",
    "playwright-core": "1.65.0",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
