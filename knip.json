{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": [
    "tools/lint.bin/eslint"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "eslint.config.js",
        ".dependency-cruiser.cjs"
      ],
      "project": [
        "*.{js,cjs,mjs,ts}",
        "scripts/**"
      ]
    },
    "packages/core": {
      "entry": [
        "src/**/*.test.ts",
        "test/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts"
      ]
    },
    "apps/api": {
      "entry": [
        "scripts/*.ts",
        "src/**/*.test.ts",
        "test/**/*.test.ts",
        "eval/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "scripts/**/*.ts",
        "test/**/*.ts",
        "eval/**/*.ts",
        "*.ts"
      ]
    },
    "apps/game": {
      "entry": [
        "src/**/*.test.ts",
        "e2e/**/*.ts",
        "build/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts",
        "e2e/**/*.ts",
        "*.ts",
        "build/**/*.ts"
      ],
      "ignoreDependencies": [
        "@fontsource/atkinson-hyperlegible",
        "@fontsource/pixelify-sans",
        "@fontsource/vt323"
      ]
    },
    "apps/voice": {
      "entry": [
        "test/**/*.test.ts",
        "test/fixtures/fault-engines.ts"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.ts",
        "bench/**/*.ts",
        "*.ts"
      ]
    }
  }
}
